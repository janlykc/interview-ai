{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Webhook: Debug Flask ingress",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "flask",
      "args": ["--app", "app", "run", "--port", "8080", "--no-reload"],
      "env": { "WEBHOOK_INGRESS_TOKEN": "local-interview-token" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Interview: Debug tests",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
