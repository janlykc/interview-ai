{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Interview: Tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Webhook: Run Flask ingress",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "flask", "--app", "app", "run", "--port", "8080"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "WEBHOOK_INGRESS_TOKEN": "local-interview-token" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Webhook: Run outbox publisher",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["publisher.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PUBSUB_EMULATOR_HOST": "127.0.0.1:8085" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
